#!/bin/bash
# Copy locally-authored skills from source (dot_agents/skills-local/) to the
# canonical store (~/.agents/skills/) so they are visible alongside skills
# installed via the GitHub lock channel (run_onchange_after_install-skills.sh).
#
# Re-runs on `chezmoi apply` whenever any local skill file changes (the hashes
# below change with them — same trick as the Brewfile / skill-lock mechanism).
#
# `after_` guarantees that the ~/.claude/skills symlink (managed by
# dot_claude/symlink_skills) is already in place before this script runs.
#
# GitHub-sourced skills and local skills coexist because each occupies its own
# subdirectory inside the store; `skills add` (the GitHub installer) only
# touches the entries listed in the lock file and performs no prune of other
# directories.
#
# ハッシュは skill・ファイル単位で明示列挙する（glob 展開はできない）。サポート
# ファイルを追加したら、その1ファイルにつき1行ここに追記すること。追記を忘れると
# スクリプト内容が変わらず、既存マシンでコピーが再実行されない。
#
# local-skill hash: {{ include "dot_agents/skills-local/review-io-impact/SKILL.md" | sha256sum }}
# local-skill hash: {{ include "dot_agents/skills-local/svg-diagram/SKILL.md" | sha256sum }}
# local-skill hash: {{ include "dot_agents/skills-local/svg-diagram/components/client-node.html" | sha256sum }}
# local-skill hash: {{ include "dot_agents/skills-local/svg-diagram/components/webserver-node.html" | sha256sum }}
# local-skill hash: {{ include "dot_agents/skills-local/svg-diagram/components/database-node.html" | sha256sum }}
# local-skill hash: {{ include "dot_agents/skills-local/svg-diagram/components/packet.html" | sha256sum }}
# local-skill hash: {{ include "dot_agents/skills-local/svg-diagram/components/orbiting-dot.html" | sha256sum }}
# local-skill hash: {{ include "dot_agents/skills-local/svg-diagram/examples/sequence-diagram.html" | sha256sum }}
# local-skill hash: {{ include "dot_agents/skills-local/svg-diagram/examples/packet-flow.html" | sha256sum }}
set -e

SRC="$HOME/.agents/skills-local"
DEST="$HOME/.agents/skills"

[ -d "$SRC" ] || exit 0

mkdir -p "$DEST"

# source から削除した自作 skill。このスクリプトは $SRC を走査してコピーするだけで
# prune しないため、既存マシンの store に残った実体をここで明示的に取り除く。
# 全マシンが apply 済みになったら該当エントリは削除してよい。
# 注意: GitHub lock チャネルの skill 名は書かないこと（そちらの実体を消してしまう）。
REMOVED_SKILLS=(
  plan-to-html # 20260727: /crit で代替できるため廃止
)

for name in "${REMOVED_SKILLS[@]}"; do
  [ -d "$DEST/$name" ] || continue
  echo "local-skills: removing $name"
  rm -rf "${DEST:?}/$name"
done

for skill_dir in "$SRC"/*/; do
  [ -d "$skill_dir" ] || continue
  name="$(basename "$skill_dir")"
  echo "local-skills: installing $name"
  rm -rf "$DEST/$name"
  cp -R "$skill_dir" "$DEST/$name"
done
